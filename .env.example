# Conexión a Postgres en Neon (con pooler). La app la usa en tiempo de ejecución.
# `neon deploy` la escribe en .env.local; también la copias del panel de Neon.
DATABASE_URL=

# Conexión directa (sin pooler), usada por las migraciones (npm run db:migrate)
DATABASE_URL_UNPOOLED=

# Contraseña del panel /<slug>/admin
ADMIN_PASSWORD=

# Opcional: si está vacío, no se envían correos y nada falla
RESEND_API_KEY=

# Opcional: remitente de los correos. Sin esto se usa onboarding@resend.dev, que solo entrega
# al correo dueño de la cuenta de Resend; para enviar a clientes verifica un dominio en Resend.
RESEND_FROM=

# URL pública de la app (sin barra final)
APP_URL=http://localhost:3000

# Secreto para proteger el cron de restablecer la demo
CRON_SECRET=
